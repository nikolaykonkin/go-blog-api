# Сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL из docker-compose.yml (стандартный порт)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bloguser
DB_PASSWORD=blogpassword
DB_NAME=blogdb
DB_SSLMODE=disable

# JWT — ОБЯЗАТЕЛЬНО замените на свой секрет (минимум 32 символа) перед запуском
# Приложение не стартует, если JWT_SECRET не задан или оставлен дефолтным значением
JWT_SECRET=
JWT_EXPIRY_HOURS=24